#ifndef RIME_EXTRA_MODULES_H_
#define RIME_EXTRA_MODULES_H_

// String fragment appended to "default" when building kDefaultModules
// (src/rime/setup.cc); expands to e.g. `, "plugin_a", "plugin_b"`, or to
// nothing when no plugin modules are present.
#define RIME_EXTRA_MODULE_STR @RIME_EXTRA_MODULE_STR@

// Extern declarations for the plugin module keep-alive functions, and the
// calls referencing them, so the linker cannot drop plugin objects from a
// static library (src/rime_api.cc, static builds only).
#define RIME_EXTRA_MODULE_DECLS @RIME_EXTRA_MODULE_DECLS@
#define RIME_EXTRA_MODULE_REFS @RIME_EXTRA_MODULE_REFS@

#endif  // RIME_EXTRA_MODULES_H_
